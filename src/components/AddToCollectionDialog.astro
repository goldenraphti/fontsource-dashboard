---
import { slugify } from "../scripts/helper-functions.ts";
interface Props {
  fontFamily: string;
}

const { fontFamily } = Astro.props;
---

<div popover id=`add-to-collections-dialog-${slugify(fontFamily)}` data-font-name={fontFamily}>
  <form method="dialog">
    <h3>Choose which collection(s) to add {fontFamily} to:</h3>
    <ul data-add-to-collections-container></ul>
    <menu>
      <button data-action="hide-popover">Cancel</button>
      <button type="submit">Save</button>
    </menu>
  </form>
</div>
<script src="../scripts/add-to-collection.ts"></script>

<style>
  div[popover] {
    background-color: var(--emerald-dark);
    border-radius: 1rem;
    border: 1px solid white;
    padding: 2rem;

    &::backdrop {
      background-color: rgba(0, 0, 0, 0.5);
    }

    h3 {
      color: #fff;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;

        label {
          display: flex;
          align-items: center;
          gap: 0.5rem;

          input[type="checkbox"] {
            width: 1.2rem;
            height: 1.2rem;

          }
          &:hover {
            cursor: pointer;
        }
      }
    }

  }
  menu {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;

    button {
      transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
      color: #000;
    }
  }
</style>



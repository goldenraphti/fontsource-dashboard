---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import FontsPreviewList from '../../components/FontsPreviewList.astro';

const { id } = Astro.params;
---

<Layout title=" - Fonts Dashboard" isHomepage={false}>
	<div>
		<Logo small={true}  />
		<h1 data-id={id} transition:name={id}>{ id }</h1>
    <div data-filtered-fonts-list-collection hidden>
      <FontsPreviewList showFontsFilteringForm={false} showFontsPreviewCustomizationForm={false} />
    </div>
		<p data-no-font-in-collection hidden>This collection has no fonts yet. Go to the <a href="/">homepage</a> or your <a href="/favourites">saved favourites</a> to add some</p>

	</div>

	<script src="../../scripts/collection.ts"></script>
</Layout>


<style>
	div:has(> h1) {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		margin-block-start: 7rem;
		margin-block-end: 4rem;

		& > * {
			margin: 0;
		}
	}

  ul {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-block-start: 2rem !important;
    font-size: 2rem;
    list-style: circle;
    padding-inline-start: 2rem;
    align-items: flex-start;
  }
</style>
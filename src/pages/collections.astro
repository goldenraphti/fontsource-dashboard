---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="My Collections - Fonts Dashboard" isHomepage={false}>
	<div>
		<Logo small={true}  />
		<h1>My saved Collections</h1>

		<div class="my-collections">
			<h3>My collections</h3>
			<ul data-collections-container></ul>
		</div>

		<form id="create-new-collection">
			<label for="new-collection-name">New Collection Name:</label>
			<input type="text" id="new-collection-name" name="new-collection-name" required />
			<button type="submit">Create Collection</button>
		</form>
	</div>

	<script src="../scripts/collections.ts"></script>
</Layout>

<style>
	div:has(> h1) {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		margin-block-start: 7rem;
		margin-block-end: 4rem;

		& > * {
			margin: 0;
		}
	}

	 div div.my-collections {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-block-start: 2rem;
		border: 1px solid #fff;
		border-radius: 1rem;
		width: min(90vw, 700px);
		margin-block: 2rem;
		padding-inline: min(4vw, 2rem);

		ul[data-collections-container] {
			list-style: none;
			padding: 0;
			margin-block: 2rem;
			width: 100%;
			max-width: 600px;
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
		max-width: 400px;
		margin-block-start: 2rem;

		label {
			font-weight: bold;
		}

		input {
			padding: 0.5rem;
			font-size: 1rem;
			border: 1px solid #ccc;
			border-radius: 4px;
		}

		button {
			align-self: flex-start;
			padding: 0.5rem 1rem;
			font-size: 1rem;
			background-color: #007bff;
			color: white;
			border: none;
			border-radius: 4px;
			cursor: pointer;

			&:hover {
				background-color: #0056b3;
			}
		}
	}
</style>